Package: crosstabser
Title: Generate Crosstabs of Labelled Data Sets with Excel Files
Version: 0.0.0.9000
Authors@R: 
    c(
        person(given = "Urs",
               family = "Wilke",
               role = c("aut", "cre"),
               email = "urs.wilke@gmail.com",
               comment = c(ORCID = "0000-0001-7257-2524")),
        person(given = "Wolf",
